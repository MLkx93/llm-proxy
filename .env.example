# Copy this file to .env and fill in real values.
# .env is in .gitignore — NEVER commit it.

# -------------------------------------------------------------------
# LLM Provider API Keys (direct access — skip if using LiteLLM proxy)
# -------------------------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# -------------------------------------------------------------------
# LiteLLM Proxy (if you have a LiteLLM server managing provider keys)
# Set LITELLM_API_BASE to your server URL and LITELLM_API_KEY to your virtual key.
# When set, OPENAI_API_KEY / ANTHROPIC_API_KEY above are ignored.
# -------------------------------------------------------------------
LITELLM_API_BASE=http://192.168.x.x:4000
LITELLM_API_KEY=sk-your-litellm-virtual-key

# -------------------------------------------------------------------
# Nexus Firewall
# -------------------------------------------------------------------
NEXUS_BASE_URL=https://nexus.your-company.internal
NEXUS_API_KEY=your-nexus-bearer-token

# -------------------------------------------------------------------
# Audit Log
# Default: logs/audit.jsonl (relative to working directory)
# Override to an absolute path for production deployments.
# -------------------------------------------------------------------
AUDIT_LOG_PATH=logs/audit.jsonl

# -------------------------------------------------------------------
# Admin Console Demo Auth (webui_api login gate — NOT production-grade)
#
# JWT_SECRET signs the admin console's login tokens. DEMO_ACCOUNTS is a
# hardcoded "username:password:role" list, comma-separated. Both ship with
# public, guessable defaults for local/demo use — override them for any
# deployment reachable outside your laptop, or better: set OIDC_ENABLED=true
# below and configure Keycloak/OIDC instead of DEMO_ACCOUNTS entirely.
# -------------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-32-byte-value
JWT_EXPIRY_HOURS=12
DEMO_ACCOUNTS=admin:change-me:admin,user:change-me:user

# -------------------------------------------------------------------
# Keycloak / OIDC (production alternative to DEMO_ACCOUNTS above)
# When OIDC_ENABLED=true, the admin console and audit API require a valid
# Keycloak-issued token instead of the demo login gate.
# -------------------------------------------------------------------
OIDC_ENABLED=false
KEYCLOAK_SERVER_URL=https://sso.your-company.internal
KEYCLOAK_REALM=security
KEYCLOAK_CLIENT_ID=your-spa-client-id
KEYCLOAK_AUDIENCE=account
KEYCLOAK_ADMIN_ROLE=security-admin

# -------------------------------------------------------------------
# Vulnerability Scanning (optional - uses OSV and CVE databases)
# -------------------------------------------------------------------
# Enable vulnerability scanning (true/false)
VULN_SCAN_ENABLED=false

# Minimum severity level to block packages (CRITICAL, HIGH, MEDIUM, LOW)
VULN_MIN_SEVERITY=HIGH

# Cache TTL for vulnerability scan results in seconds (default: 3600 = 1 hour)
VULN_CACHE_TTL=3600

# Enable OSV database (Google's open source vulnerability database)
VULN_OSV_ENABLED=true

# Enable CVE database (NVD - National Vulnerability Database)
VULN_CVE_ENABLED=true

# Snyk API Key for enhanced vulnerability intelligence (optional)
VULN_SNYK_API_KEY=

# -------------------------------------------------------------------
# Version Validation (Phase 2 - Advanced package version checking)
# -------------------------------------------------------------------
# Enable version-specific vulnerability checking (true/false)
VERSION_VALIDATION_ENABLED=false

# Path to security advisories database (SQLite)
VERSION_ADVISORY_DB_PATH=security_advisories.db

# Enable automatic updates from external sources (true/false)
VERSION_AUTO_UPDATE_DB=true

# Update interval in hours (default: 24)
VERSION_UPDATE_INTERVAL_HOURS=24

# -------------------------------------------------------------------
# Dependency Tree Analysis (Phase 3 - Transitive dependency scanning)
# -------------------------------------------------------------------
# Enable dependency tree analysis (true/false)
DEPENDENCY_SCAN_ENABLED=false

# Maximum depth for transitive dependency resolution (default: 3)
DEPENDENCY_MAX_DEPTH=3

# Risk score threshold to block packages (default: 10.0)
DEPENDENCY_RISK_THRESHOLD=10.0

# Block packages with CRITICAL vulnerabilities in dependency tree (true/false)
DEPENDENCY_BLOCK_ON_CRITICAL=true

# -------------------------------------------------------------------
# Code Sandbox Validation (Phase 4 - Behavioral analysis)
# -------------------------------------------------------------------
# Enable code sandbox execution (true/false)
SANDBOX_ENABLED=false

# Docker image for sandbox environment
SANDBOX_IMAGE=python:3.11-slim

# Execution timeout in seconds (default: 30)
SANDBOX_TIMEOUT_SECONDS=30

# Memory limit for sandbox (e.g., 512m, 1g)
SANDBOX_MEMORY_LIMIT=512m

# CPU limit for sandbox (e.g., 1.0, 2.0)
SANDBOX_CPU_LIMIT=1.0

# Enable network access in sandbox (true/false - default: false for security)
SANDBOX_NETWORK_ENABLED=false

# Risk score threshold for blocking (default: 6.0)
SANDBOX_RISK_THRESHOLD=6.0

# -------------------------------------------------------------------
# PII (Personally Identifiable Information) Handling
# -------------------------------------------------------------------
# Action to take when PII is detected in user prompts:
# - "redact": Replace PII with [REDACTED] and allow the request (default)
# - "block": Block the request when PII is detected
PII_ACTION=redact

# ---------------------------------------------------------------------------
# Added during handover — read by config/settings.py but missing from this
# template. See README.md "Configuration".
# ---------------------------------------------------------------------------

# OpenRouter — the primary provider. Setting this key is what switches the
# proxy into OpenRouter mode (there is no explicit PROVIDER= switch).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Postgres. Host port is 5433 (5432 is usually taken by a local install).
# docker-compose overrides this per-container to postgres:5432.
DATABASE_URL=postgresql+asyncpg://shield:shield@localhost:5433/shield

# Upstream timeout, seconds.
LLM_TIMEOUT_S=120

# SSE streaming. Off by default; scans chunks as they arrive.
STREAMING_ENABLED=false

# Always-on pattern-based malicious code detection (Phase 0).
MALICIOUS_CODE_ENABLED=true
MALICIOUS_CODE_BLOCK_LEVEL=HIGH

# Credentials block by default; PII redacts. See README "Design notes".
CREDENTIAL_ACTION=block

# Guardrails (Phase 5) — toxicity / hallucination / prompt-leakage checks.
GUARDRAILS_ENABLED=false
GUARDRAILS_TOXICITY_THRESHOLD=5.0
GUARDRAILS_HALLUCINATION_THRESHOLD=3.0
GUARDRAILS_PROMPT_LEAKAGE_THRESHOLD=4.0
GUARDRAILS_CONTENT_SAFETY_THRESHOLD=4.0
GUARDRAILS_BLOCK_ON_CRITICAL=true
GUARDRAILS_EARLY_TERMINATION=true

# NOTE: NEXUS_FAIL_OPEN is defined in config/settings.py but is not read
# anywhere in the code — setting it has no effect. See README known issue 1.
