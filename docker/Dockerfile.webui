# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Stage 1: dependency builder
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS builder

WORKDIR /build

COPY requirements.txt .
RUN pip install --upgrade pip --no-cache-dir \
 && pip install --no-cache-dir -r requirements.txt

# ---------------------------------------------------------------------------
# Stage 2: runtime image
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

# Security: run as non-root
RUN groupadd --gid 1002 webui \
 && useradd --uid 1002 --gid webui --no-create-home --shell /sbin/nologin webui

WORKDIR /app

COPY --from=builder /usr/local /usr/local

# Application source (webui_api imports src.db.*, src.proxy.logging, config.settings)
COPY src/       ./src/
COPY config/    ./config/

RUN mkdir -p /app/logs && chown webui:webui /app/logs

USER webui

EXPOSE 8000

CMD ["uvicorn", "src.webui_api.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "2"]
